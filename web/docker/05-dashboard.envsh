#!/bin/sh
# Sourced by the nginx entrypoint before it renders the templates.
# The CSP lets the page call only the configured API or, when none is set,
# whichever server the visitor enters.
HUSHDNS_API_URL="${HUSHDNS_API_URL%/}"
export HUSHDNS_API_URL
export HUSHDNS_API_CONNECT_SRC="${HUSHDNS_API_URL:-http: https:}"
